<Window x:Class="RemoteWinDoctor.Desktop.SafetyRebootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restart system" Height="440" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="LeftToRight"
        Language="en-US"
        Style="{StaticResource WindowTextStyle}">

    <Border Background="#2B2B2B" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.5" />
        </Border.Effect>

        <Grid Margin="24,20,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Restart system" Style="{StaticResource RowTitleStyle}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="BtnClose" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" Click="BtnClose_Click" />
            </Grid>

            <StackPanel Grid.Row="1">
                <Border x:Name="LocalAlertBanner" Background="{StaticResource DangerSoftBrush}" BorderBrush="#55E5675F" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="This is your own PC" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="If you continue, this PC restarts immediately and every open program is closed." Style="{StaticResource RowDescStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Style="{StaticResource RowStyle}" Padding="16,10">
                            <Grid>
                                <TextBlock Text="Address" Style="{StaticResource CaptionStyle}" FontSize="12" />
                                <TextBlock x:Name="TxtTargetIp" Text="--" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource LastRowStyle}" Padding="16,10">
                            <Grid>
                                <TextBlock Text="Hostname" Style="{StaticResource CaptionStyle}" FontSize="12" />
                                <TextBlock x:Name="TxtTargetName" Text="--" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="ChkConfirm" Content="I understand open programs on that system will be closed." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14" Checked="OnValidationChanged" Unchecked="OnValidationChanged" />

                <TextBlock Text="Type REBOOT to confirm:" Style="{StaticResource CaptionStyle}" FontSize="12" Margin="0,0,0,6" />
                <TextBox x:Name="TxtRebootWord" CharacterCasing="Upper" HorizontalContentAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="15" FlowDirection="LeftToRight" TextChanged="OnValidationChanged" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="BtnCancel_Click" />
                <Button x:Name="BtnConfirmReboot" Content="Restart" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Right" IsEnabled="False" Click="BtnConfirmReboot_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
