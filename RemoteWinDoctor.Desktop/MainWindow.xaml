                            </WrapPanel>
                            <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <TextBox x:Name="TxtTerminalOutput" Background="Transparent" Foreground="#D4D4D4" BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FlowDirection="LeftToRight" VerticalContentAlignment="Top" Text="RemoteWinDoctor console ready.&#x0a;" />
                            </Border>
                            <Grid Grid.Row="3" Margin="0,10,0,0" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PS&gt;" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="TxtTerminalInput" Grid.Column="1" Style="{StaticResource MonoBoxStyle}" KeyDown="TxtTerminalInput_KeyDown" />
                                <Button Grid.Column="2" Content="Run" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="BtnSendCmd_Click" />
                            </Grid>
                        </Grid>

                        <!-- Busy overlay -->
                        <Border x:Name="BusyOverlay" Background="#B31B1B1B" Visibility="Collapsed" CornerRadius="10,0,0,0" Panel.ZIndex="999">
                            <Border Background="#2B2B2B" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="26,22" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock x:Name="TxtBusyMessage" Text="Working..." Style="{StaticResource RowTitleStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <ProgressBar IsIndeterminate="True" Style="{StaticResource LoadingBarStyle}" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- Footer status -->
                    <Grid Grid.Row="1" Margin="36,0,20,0">
                        <TextBlock x:Name="TxtStatus" Text="Ready." Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="v2.1" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
