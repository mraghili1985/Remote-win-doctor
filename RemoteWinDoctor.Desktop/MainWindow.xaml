<Window x:Class="RemoteWinDoctor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteWinDoctor" Height="860" Width="1280"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="LeftToRight"
        Language="en-US"
        Style="{StaticResource WindowTextStyle}">

    <Window.Resources>
        <!-- Sidebar status card that opens the connection editor (Folder Tidy "Watching Downloads" card) -->
        <Style x:Key="SidebarCardButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="Margin" Value="0,10,0,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="MonoBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource ChromeBrush}" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Title bar ============ -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="RemoteWinDoctor" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="&#xE921;" Style="{StaticResource TitleBarBtnStyle}" Click="BtnMinimize_Click" />
                    <Button Content="&#xE922;" Style="{StaticResource TitleBarBtnStyle}" Click="BtnMaximize_Click" />
                    <Button Content="&#xE8BB;" Style="{StaticResource TitleBarCloseBtnStyle}" Click="BtnClose_Click" />
                </StackPanel>
            </Grid>

            <!-- ============ Sidebar ============ -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="12,4,12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SidebarNavPanel">
                        <RadioButton x:Name="NavProfiles" Tag="&#xE7F8;" Content="Systems" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavRadar" Tag="&#xE968;" Content="Network Radar" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavDiag" Tag="&#xE9D9;" Content="Hardware Diagnostics" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavOpt" Tag="&#xE945;" Content="Optimizer" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavToolbox" Tag="&#xEC7A;" Content="Health Toolbox" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAi" Tag="&#xE99A;" Content="AI Readiness" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavDrivers" Tag="&#xE7B8;" Content="Driver Installer" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavDevDb" Tag="&#xE943;" Content="SQL Server &amp; Visual Studio" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavRescue" Tag="&#xE7BA;" Content="Boot Rescue" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavOffice" Tag="&#xE749;" Content="Network, Printer &amp; DNS" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavTerminal" Tag="&#xE756;" Content="PowerShell Console" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Target status card + connection editor popup -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <Button x:Name="BtnTargetCard" Style="{StaticResource SidebarCardButtonStyle}" Click="BtnTargetCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BadgeMode" Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{StaticResource SuccessBrush}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock x:Name="TxtTargetSummary" Text="--" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TxtModeBadge" Text="This PC" Style="{StaticResource CaptionStyle}" FontSize="12" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE70E;" Style="{StaticResource IconStyle}" FontSize="10" />
                        </Grid>
                    </Button>
                    <TextBlock x:Name="TxtHostIpLabel" Text="Host: ..." Style="{StaticResource CaptionStyle}" Margin="4,8,0,0" />

                    <Popup x:Name="PopupTarget" PlacementTarget="{Binding ElementName=BtnTargetCard}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8">
                        <Border Width="300" Background="#2B2B2B" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="18" FlowDirection="LeftToRight"
                                TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="13" TextElement.Foreground="{StaticResource TextPrimaryBrush}"
                                NumberSubstitution.CultureSource="Text" NumberSubstitution.Substitution="European">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Target system" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="All tools run against this system." Style="{StaticResource RowDescStyle}" />

                                <UniformGrid Columns="2" Margin="0,14,0,0">
                                    <Button x:Name="BtnSwitchLocal" Content="This PC" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" Click="BtnSwitchLocal_Click" />
                                    <Button x:Name="BtnSwitchRemote" Content="Remote" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Click="BtnSwitchRemote_Click" />
                                </UniformGrid>

                                <TextBlock Text="Saved profile" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="CmbProfiles" FlowDirection="LeftToRight" SelectionChanged="CmbProfiles_SelectionChanged" />

                                <TextBlock Text="IP address" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TxtIp" Text="192.168.1.100" Style="{StaticResource MonoBoxStyle}" TextChanged="TxtIp_TextChanged" />

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="TxtUser" Text="Administrator" FlowDirection="LeftToRight" />
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" />
                                        <PasswordBox x:Name="TxtPass" FlowDirection="LeftToRight" />
                                    </StackPanel>
                                </UniformGrid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnTestConnection" Grid.Column="0" Content="Test connection" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,0" Click="BtnTestConnection_Click" />
                                    <Button x:Name="BtnRemoteReboot" Grid.Column="1" Content="Restart" Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0" Click="BtnRemoteReboot_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <!-- ============ Content panel ============ -->
            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource ContentBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" CornerRadius="10,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <!-- ===== SYSTEMS ===== -->
                        <ScrollViewer x:Name="ViewProfiles" Visibility="Visible" Padding="36,30,36,24">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Systems" Style="{StaticResource PageTitleStyle}" />
                                        <TextBlock Text="Pick a system; diagnostics, optimization and every other tool run against it." Style="{StaticResource PageDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="Add system" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnAddProfile_Click" />
                                        <Button Content="Use this PC" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSwitchLocal_Click" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Saved systems" Style="{StaticResource SectionTitleStyle}" />
                                <Border Style="{StaticResource ListCardStyle}">
                                    <StackPanel x:Name="ProfilesContainer" />
                                </Border>

                                <TextBlock Text="Remote connection setup" Style="{StaticResource SectionTitleStyle}" />
                                <Border Style="{StaticResource ListCardStyle}">
                                    <StackPanel>
                                        <Border Style="{StaticResource RowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="Target PC" Style="{StaticResource RowTitleStyle}" />
                                                    <TextBlock Text="Saves RemoteSetupTarget.bat to the Desktop. Run it once on the target PC with Run as administrator; it prints that PC's IP when done." Style="{StaticResource RowDescStyle}" />
                                                </StackPanel>
                                                <Button x:Name="BtnSaveTargetSetupScript" Grid.Column="1" Content="Save script" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="BtnSaveTargetSetupScript_Click" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource LastRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="This PC (source)" Style="{StaticResource RowTitleStyle}" />
                                                    <TextBlock Text="Starts the WinRM service and sets TrustedHosts. The app must be running as administrator." Style="{StaticResource RowDescStyle}" />
                                                </StackPanel>
                                                <Button x:Name="BtnRunSourceSetup" Grid.Column="1" Content="Set up" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="BtnRunSourceSetup_Click" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== RADAR ===== -->
                        <ScrollViewer x:Name="ViewRadar" Visibility="Collapsed" Padding="36,30,36,24">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Network Radar" Style="{StaticResource PageTitleStyle}" />
                                        <TextBlock Text="Scans all 254 subnet addresses in parallel for PCs that are online and have WinRM (port 5985) open." Style="{StaticResource PageDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBox x:Name="TxtSubnet" Text="192.168.1" Width="130" Style="{StaticResource MonoBoxStyle}" Margin="0,0,8,0" />
                                        <Button x:Name="BtnStartRadar" Content="Start scan" Style="{StaticResource PrimaryButtonStyle}" Click="BtnStartRadar_Click" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,24,0,10">
                                    <TextBlock x:Name="TxtRadarStatus" Text="Ready" Style="{StaticResource CaptionStyle}" FontSize="12" />
                                </Grid>
                                <ProgressBar x:Name="RadarProgress" Minimum="0" Maximum="254" Value="0" Style="{StaticResource LoadingBarStyle}" Margin="0,0,0,14" />

                                <DataGrid x:Name="GridRadarResults" Height="460">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="150" />
                                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*" />
                                        <DataGridTextColumn Header="Ping" Binding="{Binding RoundtripTimeMs, StringFormat='{}{0} ms'}" Width="100" />
                                        <DataGridTextColumn Header="Port 5985" Binding="{Binding StatusBadge}" Width="150" />
                                        <DataGridTemplateColumn Header="" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Select" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Click="BtnSelectRadarDevice_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== DIAGNOSTICS ===== -->
                        <ScrollViewer x:Name="ViewDiag" Visibility="Collapsed" Padding="36,30,36,24">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Hardware Diagnostics" Style="{StaticResource PageTitleStyle}" />
                                        <TextBlock Text="Checks the CPU, RAM and channels, system disk, GPU and Windows errors, and scores health from what it actually finds." Style="{StaticResource PageDescStyle}" />
                                    </StackPanel>
                                    <Button x:Name="BtnRunDiag" Grid.Column="1" Content="Run scan" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Top" Click="BtnRunDiag_Click" />
                                </Grid>

                                <Border Style="{StaticResource GlassPanelStyle}" Margin="0,24,0,0" Padding="22,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="104" Height="104" Margin="0,0,24,0" FlowDirection="LeftToRight">
                                            <Ellipse Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="8" />
                                            <Path x:Name="HealthArc" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource AccentBrush}" />
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="TxtDiagHealthScore" Text="--" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock Text="of 100" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" FlowDirection="LeftToRight" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtDiagHealthGrade" Text="No scan yet" Style="{StaticResource RowTitleStyle}" FontSize="18" />
                                            <TextBlock x:Name="TxtDiagHealthSummary" Text="Click &quot;Run scan&quot; to start." Style="{StaticResource RowDescStyle}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <UniformGrid Columns="4" Margin="0,12,0,0">
                                    <Border Style="{StaticResource GlassPanelStyle}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Processor" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock x:Name="TxtCpuName" Text="--" FontWeight="SemiBold" Margin="0,6,0,4" TextWrapping="Wrap" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="TxtCpuMetrics" Text="--" Style="{StaticResource RowDescStyle}" LineHeight="20" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassPanelStyle}" Margin="6,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Memory" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock x:Name="TxtRamTotal" Text="-- GB" FontWeight="SemiBold" Margin="0,6,0,4" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="TxtRamChannel" Text="--" Style="{StaticResource RowDescStyle}" LineHeight="20" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassPanelStyle}" Margin="6,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Graphics" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock x:Name="TxtGpuName" Text="--" FontWeight="SemiBold" Margin="0,6,0,4" TextWrapping="Wrap" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="TxtGpuVram" Text="--" Style="{StaticResource RowDescStyle}" LineHeight="20" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassPanelStyle}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Windows disk (C:)" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock x:Name="TxtDiskModel" Text="--" FontWeight="SemiBold" Margin="0,6,0,4" TextWrapping="Wrap" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="TxtDiskHealth" Text="--" Style="{StaticResource RowDescStyle}" LineHeight="20" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="RAM slots" Style="{StaticResource SectionTitleStyle}" />
                                <Border x:Name="BannerBottleneck" Background="{StaticResource WarningSoftBrush}" BorderBrush="#55E0A43A" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconStyle}" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0" />
                                        <StackPanel>
                                            <TextBlock Text="RAM is running in single-channel mode" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                                            <TextBlock Text="Memory bandwidth is half of dual-channel. Adding a matching module on the other channel makes it dual-channel." Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <UniformGrid Columns="4">
                                    <Border x:Name="SlotDimm1" Style="{StaticResource GlassPanelStyle}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Slot 1" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock x:Name="TxtSlot1Info" Text="--" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SlotDimm2" Style="{StaticResource GlassPanelStyle}" Margin="6,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Slot 2" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock x:Name="TxtSlot2Info" Text="--" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SlotDimm3" Style="{StaticResource GlassPanelStyle}" Margin="6,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Slot 3" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock x:Name="TxtSlot3Info" Text="--" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SlotDimm4" Style="{StaticResource GlassPanelStyle}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Slot 4" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock x:Name="TxtSlot4Info" Text="--" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Channel A" Style="{StaticResource CaptionStyle}" Margin="6,0,16,0" VerticalAlignment="Center" />
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource PurpleBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Channel B" Style="{StaticResource CaptionStyle}" Margin="6,0,16,0" VerticalAlignment="Center" />
                                    <Ellipse Width="8" Height="8" Stroke="{StaticResource BorderStrongBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Empty" Style="{StaticResource CaptionStyle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel x:Name="HealthIssuesSection" Visibility="Collapsed">
                                    <TextBlock Text="Issues found" Style="{StaticResource SectionTitleStyle}" />
                                    <Border Style="{StaticResource ListCardStyle}">
                                        <StackPanel x:Name="HealthIssuesPanel" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== OPTIMIZER (with persisted before/after) ===== -->
                        <ScrollViewer x:Name="ViewOpt" Visibility="Collapsed" Padding="36,30,36,24">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Optimizer" Style="{StaticResource PageTitleStyle}" />
                                        <TextBlock Text="System state is measured and saved before and after optimizing. If the PC restarts, click &quot;Compare after restart&quot; once it is back up." Style="{StaticResource PageDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button x:Name="BtnCompareAfterReboot" Content="Compare after restart" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnCompareAfterReboot_Click" />
                                        <Button x:Name="BtnRunOptimize" Content="Run optimization" Style="{StaticResource PrimaryButtonStyle}" Click="BtnRunOptimize_Click" />
                                    </StackPanel>
                                </Grid>

                                <!-- Live monitoring: one long-lived PowerShell stream, sample every ~2s -->
                                <Grid Margin="0,24,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Live monitor" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtLiveInfo" Grid.Column="1" Text="Off" Style="{StaticResource CaptionStyle}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <Button x:Name="BtnLiveMonitor" Grid.Column="2" Content="Start monitoring" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Click="BtnLiveMonitor_Click" />
                                </Grid>
                                <Border Style="{StaticResource GlassPanelStyle}">
                                    <StackPanel>
                                        <UniformGrid Columns="3">
                                            <StackPanel Margin="0,0,10,0">
                                                <Grid>
                                                    <TextBlock Text="Processor" Style="{StaticResource CaptionStyle}" FontSize="12" />
                                                    <TextBlock x:Name="TxtLiveCpu" Text="--" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                                                </Grid>
                                                <Border Height="54" Margin="0,8,0,0" Background="#232323" CornerRadius="4" ClipToBounds="True">
                                                    <Canvas x:Name="SparkCpu" FlowDirection="LeftToRight" SizeChanged="Spark_SizeChanged" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Margin="5,0,5,0">
                                                <Grid>
                                                    <TextBlock Text="RAM" Style="{StaticResource CaptionStyle}" FontSize="12" />
                                                    <TextBlock x:Name="TxtLiveRam" Text="--" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                                                </Grid>
                                                <Border Height="54" Margin="0,8,0,0" Background="#232323" CornerRadius="4" ClipToBounds="True">
                                                    <Canvas x:Name="SparkRam" FlowDirection="LeftToRight" SizeChanged="Spark_SizeChanged" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Margin="10,0,0,0">
                                                <Grid>
                                                    <TextBlock Text="Disk activity" Style="{StaticResource CaptionStyle}" FontSize="12" />
                                                    <TextBlock x:Name="TxtLiveDisk" Text="--" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
